# Production environment checklist — copy values into the host's dashboard
# (Render env vars / Docker -e). NEVER put these in Vite variables (VITE_*) or
# in the client bundle: the browser must not see them.

# --- Required ---
# Postgres connection string (Neon pooled endpoint recommended; ends with a DB name).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# HMAC key for session-cookie hashes, at least 16 random chars (Render can generate).
SESSION_SECRET=long-random-string-here
# Public origin of the deployed app, used for SIWE domain binding and CORS.
# Must match the URL browsers use, scheme included. The sign-in message domain
# is this origin's host (e.g. "chog-legacy.onrender.com wants you to sign in…").
APP_ORIGIN=https://chog-legacy.onrender.com
# Identity-space label for chain characters (default chog-mainnet is fine;
# lowercase letters, digits, dashes). Not the sign-in domain.
IDENTITY_NAMESPACE=chog-mainnet

# --- Host-provided / set as below ---
NODE_ENV=production
HOST=0.0.0.0
API_PORT=8080
# Behind Render's TLS-terminating proxy: honor x-forwarded-for for rate limits.
TRUST_PROXY=1
# Neon requires TLS; Node connects with rejectUnauthorized=false for the pool.
DB_SSL=1

# --- Optional (defaults verified against mainnet) ---
MAINNET_RPC_URL=https://rpc.monad.xyz
MAINNET_CHAIN_ID=143
CHOG_CONTRACT_ADDRESS=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
HISTORY_START_BLOCK=101997010
METADATA_TTL_MS=3600000
SESSION_TTL_MS=86400000
NONCE_TTL_MS=300000
