# Copy to .env for local development. Never commit .env.
# PostgreSQL (local Docker: see README)
DATABASE_URL=postgres://chog:chog_local_dev_only@127.0.0.1:5432/chog_dev
# Must contain "test" in the database name; tests refuse to run otherwise.
DATABASE_URL_TEST=postgres://chog:chog_local_dev_only@127.0.0.1:5432/chog_test

# Monad mainnet
MAINNET_RPC_URL=https://rpc.monad.xyz
MAINNET_CHAIN_ID=143
CHOG_CONTRACT_ADDRESS=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
HISTORY_START_BLOCK=101997010

# API
API_PORT=8420
APP_ORIGIN=http://localhost:5173
METADATA_TTL_MS=3600000
# Minimum wait between automatic metadata recovery attempts for the same token (default 15000).
METADATA_RETRY_COOLDOWN_MS=15000

# Auth (Milestone 3)
# HMAC key for session-cookie hashes. At least 16 chars; required in production;
# if unset (dev only) a random per-process secret is generated and sessions reset on restart.
SESSION_SECRET=change-me-to-a-long-random-string
# Session cookie lifetime (default 24h). Must be positive.
SESSION_TTL_MS=86400000
# SIWE nonce lifetime (default 5 min). Must be positive.
NONCE_TTL_MS=300000
# Domain binding for issued SIWE nonces; lowercase letters, digits, dashes.
IDENTITY_NAMESPACE=chog-mainnet
